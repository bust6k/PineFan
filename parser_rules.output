Grammar

    0 $accept: program $end

    1 program: statement
    2        | program statement

    3 statement: indicator_stmt
    4          | strategy_stmt
    5          | if_stmt
    6          | for_stmt
    7          | while_stmt
    8          | return_stmt_expr
    9          | break_stmt
   10          | continue_stmt
   11          | switch_stmt
   12          | var_stmt
   13          | const_stmt
   14          | simple_stmt
   15          | func_stmt
   16          | call_arg_stmt
   17          | import_stmt
   18          | assignment_stmt
   19          | assignment_re_stmt
   20          | expr

   21 block: left_brace stmt_list right_brace

   22 stmt_list: stmt_list stmt_block
   23          | stmt_block

   24 stmt_block: statement

   25 if_body: block
   26        | statement

   27 indicator_stmt: indicator_function left_paren string right_paren

   28 strategy_stmt: strategy_function left_paren string right_paren

   29 if_stmt: if_statement left_paren expr right_paren if_body
   30        | if_statement left_paren expr right_paren if_body else_statement if_body

   31 for_stmt: for_statement left_paren identifier assign expr to expr right_paren block
   32         | for_statement left_paren identifier assign expr to expr step expr right_paren block
   33         | for_statement left_paren expr right_paren block

   34 while_stmt: while_statement left_paren expr right_paren block

   35 func_stmt: identifier func_paren opt_arg_list func_paren block

   36 opt_arg_list: arg_list
   37             | ε

   38 arg_list: arg_list comma func_type
   39         | func_type

   40 func_type: pine_type identifier
   41          | pine_type
   42          | pine_type dot pine_type identifier
   43          | pine_type dot pine_type
   44          | pine_type lesser_than func_type greater_than identifier
   45          | pine_type dot pine_type lesser_than func_type greater_than identifier

   46 pine_type: int_type
   47          | bool_type
   48          | string_as_type
   49          | float_type
   50          | color_type
   51          | identifier

   52 return_stmt_expr: return_statement expr

   53 break_stmt: break_statement

   54 continue_stmt: continue_statement

   55 switch_stmt: switch_statement left_paren expr right_paren left_brace case_list default_case right_brace

   56 case_list: case_list case_stmt
   57          | ε

   58 case_stmt: expr left_brace switch_block_stmts right_brace semicolon

   59 default_case: default_statement left_brace switch_block_stmts right_brace semicolon
   60             | ε

   61 switch_block_stmt: statement

   62 switch_block_stmts: switch_block_stmt
   63                   | switch_block_stmts switch_block_stmt

   64 dot_expr: pine_type dot identifier

   65 call_arg_stmt: identifier left_paren call_list right_paren
   66              | dot_expr left_paren call_list right_paren

   67 call_list: call_stmt
   68          | call_list comma call_stmt
   69          | ε

   70 call_stmt: expr

   71 var_stmt: var identifier assign expr
   72         | var identifier
   73         | var identifier assign call_arg_stmt

   74 const_stmt: const_statement identifier assign expr
   75           | const_statement identifier assign call_arg_stmt

   76 simple_stmt: simple identifier
   77            | simple identifier assign expr
   78            | simple identifier assign call_arg_stmt

   79 import_stmt: import_statement string

   80 assignment_stmt: identifier assign expr
   81                | identifier assign call_arg_stmt
   82                | expr assign expr

   83 assignment_re_stmt: identifier re_assign expr
   84                   | identifier re_assign call_arg_stmt
   85                   | expr re_assign expr

