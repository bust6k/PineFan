Grammar

    0 $accept: program $end

    1 program: statement
    2        | program statement

    3 statement: if_stmt
    4          | for_stmt
    5          | while_stmt
    6          | return_stmt_expr
    7          | break_stmt
    8          | continue_stmt
    9          | switch_stmt
   10          | varip_stmt
   11          | var_stmt
   12          | const_stmt
   13          | simple_stmt
   14          | func_stmt
   15          | import_stmt
   16          | assignment_stmt
   17          | assignment_re_stmt
   18          | expr

   19 block: left_brace stmt_list right_brace

   20 stmt_list: stmt_list stmt_block
   21          | stmt_block

   22 stmt_block: statement

   23 if_body: block
   24        | statement

   25 if_stmt: if_statement left_paren expr right_paren if_body
   26        | if_statement left_paren expr right_paren if_body else_statement if_body

   27 for_stmt: for_statement left_paren identifier assign expr to expr right_paren block
   28         | for_statement left_paren identifier assign expr to expr step expr right_paren block
   29         | for_statement left_paren expr right_paren block

   30 while_stmt: while_statement left_paren expr right_paren block

   31 func_stmt: identifier func_paren opt_arg_list func_paren block

   32 opt_arg_list: arg_list
   33             | ε

   34 arg_list: arg_list comma func_type
   35         | func_type

   36 func_type: pine_type identifier
   37          | pine_type
   38          | pine_type dot pine_type identifier
   39          | pine_type dot pine_type
   40          | pine_type lesser_than func_type greater_than identifier
   41          | pine_type dot pine_type lesser_than func_type greater_than identifier

   42 pine_type_primitive: int_type
   43                    | bool_type
   44                    | string_as_type
   45                    | float_type
   46                    | color_type

   47 pine_type: int_type
   48          | bool_type
   49          | string_as_type
   50          | float_type
   51          | color_type
   52          | identifier

   53 return_stmt_expr: return_statement expr

   54 break_stmt: break_statement

   55 continue_stmt: continue_statement

   56 switch_stmt: switch_statement left_paren expr right_paren left_brace case_list default_case right_brace

   57 case_list: case_list case_stmt
   58          | ε

   59 case_stmt: expr left_brace switch_block_stmts right_brace semicolon

   60 default_case: default_statement left_brace switch_block_stmts right_brace semicolon
   61             | ε

   62 switch_block_stmt: statement

   63 switch_block_stmts: switch_block_stmt
   64                   | switch_block_stmts switch_block_stmt

   65 dot_expr: pine_type dot pine_type

   66 call_list: expr
   67          | call_list comma expr
   68          | ε

   69 var_stmt: var identifier assign expr

   70 varip_stmt: varip identifier assign expr

   71 const_stmt: const_statement pine_type identifier assign expr

   72 simple_stmt: simple identifier assign expr

   73 import_stmt: import_statement string

   74 assignment_stmt: expr assign expr
   75                | pine_type_primitive identifier assign expr

   76 assignment_re_stmt: expr re_assign expr

   77 expr_atom: number
   78          | identifier
   79          | string
   80          | dot_expr

   81 postfix_expr: expr_atom left_paren call_list right_paren
   82             | expr_atom left_quad_brace expr right_quad_brace

   83 expr: expr_atom
   84     | postfix_expr
   85     | expr plus_and_assign expr
   86     | expr minus_and_assign expr
   87     | expr multiply_and_assign expr
