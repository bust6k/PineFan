Grammar

    0 $accept: program $end

    1 program: statement
    2        | program statement

    3 statement: if_stmt
    4          | for_stmt
    5          | while_stmt
    6          | return_stmt_expr
    7          | break_stmt
    8          | continue_stmt
    9          | switch_stmt
   10          | varip_stmt
   11          | var_stmt
   12          | const_stmt
   13          | simple_stmt
   14          | func_stmt
   15          | import_stmt
   16          | assignment_re_stmt
   17          | expr

   18 block: left_brace stmt_list right_brace

   19 stmt_list: stmt_list stmt_block
   20          | stmt_block

   21 stmt_block: statement

   22 if_body: block
   23        | statement

   24 if_stmt: if_statement left_paren expr right_paren if_body
   25        | if_statement left_paren expr right_paren if_body else_statement if_body

   26 for_stmt: for_statement left_paren identifier assign expr to expr right_paren block
   27         | for_statement left_paren identifier assign expr to expr step expr right_paren block
   28         | for_statement left_paren expr right_paren block

   29 while_stmt: while_statement left_paren expr right_paren block

   30 func_stmt: identifier func_paren opt_arg_list func_paren block

   31 opt_arg_list: arg_list
   32             | ε

   33 arg_list: arg_list comma func_type
   34         | func_type

   35 func_type: pine_type identifier
   36          | pine_type
   37          | pine_type dot pine_type identifier
   38          | pine_type dot pine_type
   39          | pine_type lesser_than func_type greater_than identifier
   40          | pine_type dot pine_type lesser_than func_type greater_than identifier

   41 pine_type: int_type
   42          | bool_type
   43          | string_as_type
   44          | float_type
   45          | color_type
   46          | identifier

   47 return_stmt_expr: return_statement expr

   48 break_stmt: break_statement

   49 continue_stmt: continue_statement

   50 switch_stmt: switch_statement left_paren expr right_paren left_brace case_list default_case right_brace

   51 case_list: case_list case_stmt
   52          | ε

   53 case_stmt: expr left_brace switch_block_stmts right_brace semicolon

   54 default_case: default_statement left_brace switch_block_stmts right_brace semicolon
   55             | ε

   56 switch_block_stmt: statement

   57 switch_block_stmts: switch_block_stmt
   58                   | switch_block_stmts switch_block_stmt

   59 dot_expr: pine_type dot pine_type

   60 call_list: expr
   61          | call_list comma expr
   62          | ε

   63 var_stmt: var identifier assign expr
   64         | var pine_type identifier assign expr
   65         | var pine_type left_quad_brace right_quad_brace identifier assign expr
   66         | var dot_expr identifier assign expr
   67         | var dot_expr left_quad_brace right_quad_brace identifier assign expr

   68 varip_stmt: varip_statement identifier assign expr
   69           | varip_statement pine_type identifier assign expr
   70           | varip_statement pine_type left_quad_brace right_quad_brace identifier assign expr
   71           | varip_statement dot_expr identifier assign expr
   72           | varip_statement dot_expr left_quad_brace right_quad_brace identifier assign expr

   73 const_stmt: const_statement pine_type identifier assign expr
   74           | const_statement pine_type left_quad_brace right_quad_brace identifier assign expr
   75           | const_statement dot_expr identifier assign expr
   76           | const_statement dot_expr left_quad_brace right_quad_brace identifier assign expr

   77 simple_stmt: simple identifier assign expr
   78            | simple pine_type identifier assign expr
   79            | simple pine_type left_quad_brace right_quad_brace identifier assign expr
   80            | simple dot_expr identifier assign expr
   81            | simple dot_expr left_quad_brace right_quad_brace identifier assign expr

   82 import_stmt: import_statement string

   83 assignment_stmt: expr assign expr

   84 assignment_re_stmt: expr re_assign expr

   85 expr_atom: number
   86          | pine_type
   87          | string
   88          | dot_expr
   89          | left_paren expr right_paren

   90 postfix_expr: expr_atom call_paren call_list call_paren
   91             | expr_atom left_quad_brace expr right_quad_brace

   92 expr: expr_atom
   93     | postfix_expr
   94     | assignment_stmt
   95     | expr plus_and_assign expr
   96     | expr minus_and_assign expr
   97     | expr multiply_and_assign expr
   98     | expr divide_and_assign expr
   99     | expr remind_and_assign expr
  100     | expr plus expr
