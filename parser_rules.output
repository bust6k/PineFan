Grammar

    0 $accept: program $end

    1 program: statement
    2        | program statement

    3 statement: if_stmt
    4          | for_stmt
    5          | while_stmt
    6          | return_stmt_expr
    7          | break_stmt
    8          | continue_stmt
    9          | comma_stmt
   10          | switch_stmt
   11          | varip_stmt
   12          | var_stmt
   13          | const_stmt
   14          | simple_stmt
   15          | func_stmt
   16          | import_stmt
   17          | assignment_re_stmt
   18          | expr

   19 block: left_brace stmt_list right_brace

   20 stmt_list: stmt_list stmt_block
   21          | stmt_block

   22 stmt_block: statement

   23 if_body: block
   24        | statement

   25 if_stmt: if_statement left_paren expr right_paren if_body
   26        | if_statement left_paren expr right_paren if_body else_statement if_body

   27 for_stmt: for_statement left_paren identifier assign expr to expr right_paren block
   28         | for_statement left_paren identifier assign expr to expr step expr right_paren block
   29         | for_statement left_paren expr right_paren block
   30         | for_statement left_paren identifier assign expr to expr by expr right_paren block

   31 while_stmt: while_statement left_paren expr right_paren block

   32 func_stmt: identifier func_paren opt_arg_list func_paren block

   33 opt_arg_list: arg_list
   34             | ε

   35 arg_list: arg_list comma func_type
   36         | func_type

   37 func_type: pine_type identifier
   38          | pine_type
   39          | pine_type dot pine_type identifier
   40          | pine_type dot pine_type
   41          | pine_type lesser_than func_type greater_than identifier
   42          | pine_type dot pine_type lesser_than func_type greater_than identifier

   43 pine_type: int_type
   44          | bool_type
   45          | string_as_type
   46          | float_type
   47          | color_type
   48          | identifier

   49 return_stmt_expr: return_statement expr

   50 break_stmt: break_statement

   51 continue_stmt: continue_statement

   52 switch_stmt: switch_statement left_paren expr right_paren left_brace case_list default_case right_brace

   53 case_list: case_list case_stmt
   54          | ε

   55 case_stmt: expr left_brace switch_block_stmts right_brace semicolon

   56 default_case: default_statement left_brace switch_block_stmts right_brace semicolon
   57             | ε

   58 switch_block_stmt: statement

   59 switch_block_stmts: switch_block_stmt
   60                   | switch_block_stmts switch_block_stmt

   61 dot_expr: pine_type dot pine_type

   62 call_list: expr
   63          | call_list comma expr
   64          | ε

   65 var_stmt: var identifier assign expr
   66         | var pine_type identifier assign expr
   67         | var pine_type left_quad_brace right_quad_brace identifier assign expr
   68         | var dot_expr identifier assign expr
   69         | var dot_expr left_quad_brace right_quad_brace identifier assign expr

   70 varip_stmt: varip_statement identifier assign expr
   71           | varip_statement pine_type identifier assign expr
   72           | varip_statement pine_type left_quad_brace right_quad_brace identifier assign expr
   73           | varip_statement dot_expr identifier assign expr
   74           | varip_statement dot_expr left_quad_brace right_quad_brace identifier assign expr

   75 const_stmt: const_statement pine_type identifier assign expr
   76           | const_statement pine_type left_quad_brace right_quad_brace identifier assign expr
   77           | const_statement dot_expr identifier assign expr
   78           | const_statement dot_expr left_quad_brace right_quad_brace identifier assign expr

   79 simple_stmt: simple identifier assign expr
   80            | simple pine_type identifier assign expr
   81            | simple pine_type left_quad_brace right_quad_brace identifier assign expr
   82            | simple dot_expr identifier assign expr
   83            | simple dot_expr left_quad_brace right_quad_brace identifier assign expr

   84 import_stmt: import_statement string

   85 assignment_stmt: expr assign expr

   86 assignment_re_stmt: expr re_assign expr

   87 expr_atom: number
   88          | pine_type
   89          | string
   90          | dot_expr
   91          | left_paren expr right_paren

   92 postfix_expr: expr_atom call_paren call_list call_paren
   93             | expr_atom left_quad_brace expr right_quad_brace

   94 expr: expr_atom
   95     | postfix_expr
   96     | assignment_stmt
   97     | expr plus_and_assign expr
   98     | expr minus_and_assign expr
   99     | expr multiply_and_assign expr
  100     | expr divide_and_assign expr
  101     | expr remind_and_assign expr
  102     | expr plus expr
  103     | expr minus expr
  104     | expr multiply expr
  105     | expr divide expr
  106     | expr divide_with_remind expr
  107     | expr logical_and expr
  108     | expr logical_or expr
  109     | expr equals expr
  110     | expr dont_equal expr
  111     | expr greater_than expr
  112     | expr lesser_than expr
  113     | expr greater_than_or_equals expr
  114     | expr lesser_than_or_equals expr
  115     | expr bitwise_and expr
  116     | expr bitwise_or expr
  117     | expr bitwise_xor expr
  118     | expr bitwise_shift_to_left expr
  119     | expr bitwise_shift_to_right expr
  120     | logical_not expr
  121     | bitwise_not expr
  122     | minus expr
  123     | plus expr
  124     | expr question_sign expr colon expr
  125     | left_quad_brace expr_list right_quad_brace

  126 expr_list: expr
  127          | expr_list comma expr

  128 comma_stmt: expr comma expr
  129           | comma_stmt comma comma_stmt


