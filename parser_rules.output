Grammar

    0 $accept: program $end

    1 program: statement
    2        | program statement

    3 statement: indicator_stmt
    4          | strategy_stmt
    5          | if_stmt
    6          | for_stmt
    7          | while_stmt
    8          | return_stmt_expr
    9          | break_stmt
   10          | continue_stmt
   11          | switch_stmt
   12          | varip_stmt
   13          | var_stmt
   14          | const_stmt
   15          | simple_stmt
   16          | func_stmt
   17          | call_arg_stmt
   18          | import_stmt
   19          | assignment_stmt
   20          | assignment_re_stmt
   21          | compound_assign_stmt
   22          | ident_stmt

   23 ident_stmt: identifier

   24 block: left_brace stmt_list right_brace

   25 stmt_list: stmt_list stmt_block
   26          | stmt_block

   27 stmt_block: statement

   28 if_body: block
   29        | statement

   30 indicator_stmt: indicator_function left_paren string right_paren

   31 strategy_stmt: strategy_function left_paren string right_paren

   32 if_stmt: if_statement left_paren expr right_paren if_body
   33        | if_statement left_paren expr right_paren if_body else_statement if_body

   34 for_stmt: for_statement left_paren identifier assign expr to expr right_paren block
   35         | for_statement left_paren identifier assign expr to expr step expr right_paren block
   36         | for_statement left_paren expr right_paren block

   37 while_stmt: while_statement left_paren expr right_paren block

   38 func_stmt: identifier func_paren opt_arg_list func_paren block

   39 opt_arg_list: arg_list
   40             | ε

   41 arg_list: arg_list comma func_type
   42         | func_type

   43 func_type: pine_type identifier
   44          | pine_type
   45          | pine_type dot pine_type identifier
   46          | pine_type dot pine_type
   47          | pine_type lesser_than func_type greater_than identifier
   48          | pine_type dot pine_type lesser_than func_type greater_than identifier

   49 pine_type: int_type
   50          | bool_type
   51          | string_as_type
   52          | float_type
   53          | color_type
   54          | identifier

   55 return_stmt_expr: return_statement expr

   56 break_stmt: break_statement

   57 continue_stmt: continue_statement

   58 switch_stmt: switch_statement left_paren expr right_paren left_brace case_list default_case right_brace

   59 case_list: case_list case_stmt
   60          | ε

   61 case_stmt: expr left_brace switch_block_stmts right_brace semicolon

   62 default_case: default_statement left_brace switch_block_stmts right_brace semicolon
   63             | ε

   64 switch_block_stmt: statement

   65 switch_block_stmts: switch_block_stmt
   66                   | switch_block_stmts switch_block_stmt

   67 dot_expr: pine_type dot identifier

   68 call_arg_stmt: identifier left_paren call_list right_paren
   69              | dot_expr left_paren call_list right_paren

   70 call_list: call_stmt
   71          | call_list comma call_stmt
   72          | ε

   73 call_stmt: expr

   74 var_stmt: var identifier assign expr
   75         | var identifier assign call_arg_stmt

   76 varip_stmt: varip identifier assign expr
   77           | varip identifier
   78           | varip identifier assign call_arg_stmt

   79 const_stmt: const_statement pine_type identifier assign expr
   80           | const_statement pine_type identifier assign call_arg_stmt

   81 simple_stmt: simple identifier
   82            | simple identifier assign expr
   83            | simple identifier assign call_arg_stmt

   84 import_stmt: import_statement string

   85 assignment_stmt: identifier assign expr
   86                | identifier assign call_arg_stmt
   87                | dot_expr assign expr
   88                | dot_expr assign call_arg_stmt
   89                | pine_type identifier assign expr
   90                | pine_type identifier assign call_arg_stmt

   91 assignment_re_stmt: identifier re_assign expr
   92                   | identifier re_assign call_arg_stmt
   93                   | dot_expr re_assign expr
   94                   | dot_expr re_assign call_arg_stmt
   95                   | pine_type identifier re_assign expr
   96                   | pine_type identifier re_assign call_arg_stmt

   97 compound_assign_stmt: expr plus_and_assign expr
   98                     | expr minus_and_assign expr
   99                     | expr multiply_and_assign expr
  100                     | expr divide_and_assign expr
  101                     | expr remind_and_assign expr

  102 ternary_expr: expr question_sign expr colon expr
  103             | dot_expr question_sign expr colon expr
  104             | left_paren expr right_paren question_sign expr colon expr

  105 expr: ternary_expr
