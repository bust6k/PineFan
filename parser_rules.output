   14          | func_stmt
   15          | import_stmt
   16          | assignment_re_stmt
   17          | expr

   18 block: left_brace stmt_list right_brace

   19 stmt_list: stmt_list stmt_block
   20          | stmt_block

   21 stmt_block: statement

   22 if_body: block
   23        | statement

   24 if_stmt: if_statement left_paren expr right_paren if_body
   25        | if_statement left_paren expr right_paren if_body else_statement if_body

   26 for_stmt: for_statement left_paren identifier assign expr to expr right_paren block
   27         | for_statement left_paren identifier assign expr to expr step expr right_paren block
   28         | for_statement left_paren expr right_paren block

   29 while_stmt: while_statement left_paren expr right_paren block

   30 func_stmt: identifier func_paren opt_arg_list func_paren block

   31 opt_arg_list: arg_list
   32             | ε

   33 arg_list: arg_list comma func_type
   34         | func_type

   35 func_type: pine_type identifier
   36          | pine_type
   37          | pine_type dot pine_type identifier
   38          | pine_type dot pine_type
   39          | pine_type lesser_than func_type greater_than identifier
   40          | pine_type dot pine_type lesser_than func_type greater_than identifier

   41 pine_type: int_type
   42          | bool_type
   43          | string_as_type
   44          | float_type
   45          | color_type
   46          | identifier

   47 return_stmt_expr: return_statement expr

   48 break_stmt: break_statement

   49 continue_stmt: continue_statement

   50 switch_stmt: switch_statement left_paren expr right_paren left_brace case_list default_case right_brace

   51 case_list: case_list case_stmt
   52          | ε

   53 case_stmt: expr left_brace switch_block_stmts right_brace semicolon

   54 default_case: default_statement left_brace switch_block_stmts right_brace semicolon
   55             | ε

   56 switch_block_stmt: statement

   57 switch_block_stmts: switch_block_stmt
   58                   | switch_block_stmts switch_block_stmt

   59 dot_expr: pine_type dot pine_type

   60 call_list: expr
   61          | call_list comma expr
   62          | ε

   63 var_stmt: var identifier assign expr
   64         | var pine_type identifier assign expr
   65         | var dot_expr identifier assign expr

   66 varip_stmt: varip_statement identifier assign expr
