Grammar

    0 $accept: program $end

    1 program: statement
    2        | program statement

    3 statement: indicator_stmt
    4          | strategy_stmt
    5          | if_stmt
    6          | for_stmt
    7          | while_stmt
    8          | return_stmt_expr
    9          | break_stmt
   10          | continue_stmt
   11          | switch_stmt
   12          | varip_stmt
   13          | var_stmt
   14          | const_stmt
   15          | simple_stmt
   16          | func_stmt
   17          | call_arg_stmt
   18          | import_stmt
   19          | assignment_stmt
   20          | assignment_re_stmt
   21          | expr

   22 block: left_brace stmt_list right_brace

   23 stmt_list: stmt_list stmt_block
   24          | stmt_block

   25 stmt_block: statement

   26 if_body: block
   27        | statement

   28 indicator_stmt: indicator_function left_paren string right_paren

   29 strategy_stmt: strategy_function left_paren string right_paren

   30 if_stmt: if_statement left_paren expr right_paren if_body
   31        | if_statement left_paren expr right_paren if_body else_statement if_body

   32 for_stmt: for_statement left_paren identifier assign expr to expr right_paren block
   33         | for_statement left_paren identifier assign expr to expr step expr right_paren block
   34         | for_statement left_paren expr right_paren block

   35 while_stmt: while_statement left_paren expr right_paren block

   36 func_stmt: identifier func_paren opt_arg_list func_paren block

   37 opt_arg_list: arg_list
   38             | ε

   39 arg_list: arg_list comma func_type
   40         | func_type

   41 func_type: pine_type identifier
   42          | pine_type
   43          | pine_type dot pine_type identifier
   44          | pine_type dot pine_type
   45          | pine_type lesser_than func_type greater_than identifier
   46          | pine_type dot pine_type lesser_than func_type greater_than identifier

   47 pine_type_primitive: int_type
   48                    | bool_type
   49                    | string_as_type
   50                    | float_type
   51                    | color_type

   52 pine_type: int_type
   53          | bool_type
   54          | string_as_type
   55          | float_type
   56          | color_type
   57          | identifier

   58 return_stmt_expr: return_statement expr

   59 break_stmt: break_statement

   60 continue_stmt: continue_statement

   61 switch_stmt: switch_statement left_paren expr right_paren left_brace case_list default_case right_brace

   62 case_list: case_list case_stmt
   63          | ε

   64 case_stmt: expr left_brace switch_block_stmts right_brace semicolon

   65 default_case: default_statement left_brace switch_block_stmts right_brace semicolon
   66             | ε

   67 switch_block_stmt: statement

   68 switch_block_stmts: switch_block_stmt
   69                   | switch_block_stmts switch_block_stmt

   70 dot_expr: pine_type dot pine_type

   71 call_arg_stmt: identifier left_paren call_list right_paren
   72              | dot_expr left_paren call_list right_paren

   73 call_list: call_stmt
   74          | call_list comma call_stmt
   75          | ε

   76 call_stmt: expr
   77          | identifier assign expr

   78 var_stmt: var identifier assign expr
   79         | var identifier
   80         | var identifier assign call_arg_stmt

   81 varip_stmt: varip identifier assign expr
