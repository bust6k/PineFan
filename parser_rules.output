Grammar

    0 $accept: program $end

    1 program: statement
    2        | program statement

    3 statement: if_stmt
    4          | for_stmt
    5          | while_stmt
    6          | return_stmt_expr
    7          | break_stmt
    8          | continue_stmt
    9          | switch_stmt
   10          | varip_stmt
   11          | var_stmt
   12          | const_stmt
   13          | simple_stmt
   14          | func_stmt
   15          | import_stmt
   16          | assignment_re_stmt
   17          | expr

   18 block: left_brace stmt_list right_brace

   19 stmt_list: stmt_list stmt_block
   20          | stmt_block

   21 stmt_block: statement

   22 if_body: block
   23        | statement

   24 if_stmt: if_statement left_paren expr right_paren if_body
   25        | if_statement left_paren expr right_paren if_body else_statement if_body

   26 for_stmt: for_statement left_paren identifier assign expr to expr right_paren block
   27         | for_statement left_paren identifier assign expr to expr step expr right_paren block
   28         | for_statement left_paren expr right_paren block

   29 while_stmt: while_statement left_paren expr right_paren block

   30 func_stmt: identifier func_paren opt_arg_list func_paren block

   31 opt_arg_list: arg_list
   32             | ε

   33 arg_list: arg_list comma func_type
   34         | func_type

   35 func_type: pine_type identifier
   36          | pine_type
   37          | pine_type dot pine_type identifier
   38          | pine_type dot pine_type
   39          | pine_type lesser_than func_type greater_than identifier
   40          | pine_type dot pine_type lesser_than func_type greater_than identifier

   41 pine_type_primitive: int_type
   42                    | bool_type
   43                    | string_as_type
   44                    | float_type
   45                    | color_type

   46 pine_type: int_type
   47          | bool_type
   48          | string_as_type
   49          | float_type
   50          | color_type
   51          | identifier

   52 return_stmt_expr: return_statement expr

   53 break_stmt: break_statement

   54 continue_stmt: continue_statement

   55 switch_stmt: switch_statement left_paren expr right_paren left_brace case_list default_case right_brace

   56 case_list: case_list case_stmt
   57          | ε

   58 case_stmt: expr left_brace switch_block_stmts right_brace semicolon

   59 default_case: default_statement left_brace switch_block_stmts right_brace semicolon
   60             | ε

   61 switch_block_stmt: statement

   62 switch_block_stmts: switch_block_stmt
   63                   | switch_block_stmts switch_block_stmt

   64 dot_expr: pine_type dot pine_type

   65 call_list: expr
   66          | call_list comma expr
   67          | ε

   68 var_stmt: var identifier assign expr

   69 varip_stmt: varip_statement identifier assign expr

   70 const_stmt: const_statement pine_type identifier assign expr

   71 simple_stmt: simple identifier assign expr

   72 import_stmt: import_statement string

   73 assignment_stmt: expr assign expr
   74                | pine_type_primitive identifier assign expr

   75 assignment_re_stmt: expr re_assign expr

   76 expr_atom: number
   77          | identifier
   78          | string
   79          | dot_expr
   80          | left_paren expr right_paren

   81 postfix_expr: expr_atom call_paren call_list call_paren
   82             | expr_atom left_quad_brace expr right_quad_brace

   83 expr: expr_atom
